RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Cache static assets (1 year — filenames are hashed by Vite)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType application/pdf          "access plus 6 months"
  # HTML — no cache (always fresh)
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom 404 page (solo para rutas HTML, NO para assets)
ErrorDocument 404 /404.html

# MIME explícitos (evita respuestas ambiguas en algunos hosts)
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
</IfModule>

# No cachear HTML: el index referencia assets con hash; si el HTML está viejo en caché
# y el servidor ya desplegó otro build, el navegador pide .js/.css que ya no existen.
<IfModule mod_headers.c>
  # Cualquier .html, no solo index/404: las páginas prerenderizadas también
  # referencian bundles con hash y una copia vieja en caché pediría ficheros
  # que ya no existen.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  # ga.js no lleva hash en el nombre (no lo genera Vite, vive en public/).
  # Sin esta excepción heredaría el "1 year" de los assets y un cambio de
  # Measurement ID tardaría hasta un año en llegar a los visitantes.
  <FilesMatch "^ga\.js$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Assets faltantes: devolver 404 sin HTML para evitar errores de MIME en el navegador.
# Si Apache sirve /404.html para un .js o .css que no existe, el browser ve
# Content-Type: text/html y lanza "MIME type mismatch". Con [G] devuelve 410 Gone
# pero sin cuerpo HTML — lo suficiente para que el browser no confunda el tipo.
RewriteCond %{REQUEST_URI} ^/assets/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L]

# ── Standalone HTML pages (served WITHOUT .html extension) ──────
# /brochure or /brochure/  →  /brochure.html
RewriteCond %{REQUEST_URI} ^/brochure/?$ [NC]
RewriteRule ^ /brochure.html [L]

# ── Páginas prerenderizadas ────────────────────────────────────
# El SPA se renderiza en el cliente, así que sin esto todas las rutas sirven un
# <div id="root"> vacío: Google ejecuta JS y lo resuelve, pero Bing y los bots
# de IA que permite robots.txt no. scripts/prerender.mjs deja una copia ya
# renderizada de cada URL del sitemap y estas reglas la sirven.
#
# Cada regla comprueba antes que el fichero exista (-f). Si el prerenderizado
# no se ejecutó, ninguna coincide y todo cae al fallback del SPA de abajo, que
# es el comportamiento de siempre.

# Inglés: /?lang=en → /index.en.html
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteCond %{DOCUMENT_ROOT}/index.en.html -f
RewriteRule ^$ /index.en.html [L]

# Inglés: /proyecto/<id>?lang=en → /proyecto/<id>.en.html
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteCond %{DOCUMENT_ROOT}/proyecto/$1.en.html -f
RewriteRule ^proyecto/([a-z-]+)/?$ /proyecto/$1.en.html [L]

# Español (canónico): /proyecto/<id> → /proyecto/<id>.html
# La portada en español ya es index.html, que sirve DirectoryIndex.
RewriteCond %{DOCUMENT_ROOT}/proyecto/$1.html -f
RewriteRule ^proyecto/([a-z-]+)/?$ /proyecto/$1.html [L]

# SPA fallback — solo rutas de app (no archivos estáticos ni /assets/)
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
